# Non-interactive init writes the deterministic commented example.
# The file validates; an existing path is exit 2; -o - writes stdout.

exec incusos-builder init --no-input -o config.yaml --color never
exists config.yaml
grep 'Generated by incusos-builder init --no-input' config.yaml
grep 'type: iso' config.yaml
grep '#  applications: {}' config.yaml
grep '#  security: {}' config.yaml

exec incusos-builder validate -f config.yaml --color never
stdout 'configuration valid'

exits 2 incusos-builder init --no-input -o config.yaml
stderr 'refusing to overwrite existing file'

exec incusos-builder init --no-input -o - --color never
stdout 'Generated by incusos-builder init --no-input'
stdout 'type: iso'
stdout '#  kernel: {}'
